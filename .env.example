# Conexión a PostgreSQL
AA_DB_HOST=localhost
AA_DB_PORT=5432
AA_DB_NAME=autoaudit

# Credenciales para la CLI y las pruebas (usuarios de prueba creados por sql/90_demo_datos.sql).
# En la web cada persona inicia sesión con su propio usuario de PostgreSQL.
AA_USUARIO=aa_admin
AA_CLAVE=AutoAudit.Admin1
AA_LECTOR_USUARIO=aa_lector
AA_LECTOR_CLAVE=AutoAudit.Lector1
AA_NEGOCIO_USUARIO=cajero1
AA_NEGOCIO_CLAVE=Cajero.Uno1
AA_NEGOCIO2_USUARIO=cajero2
AA_NEGOCIO2_CLAVE=Cajero.Dos2

# (Opcional) Acceso de demostración de solo lectura que se muestra en la pantalla de inicio
# AA_DEMO_USUARIO=aa_lector
# AA_DEMO_CLAVE=AutoAudit.Lector1

# Minutos de inactividad antes de cerrar la sesión web
AA_SESION_MINUTOS=60
